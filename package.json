{
  "name": "notion-mcp-bridge",
  "version": "0.1.0",
  "description": "Local MCP bridge that exposes Roblox Studio, local files, web fetch and other stdio MCP servers to Notion Agent over an authenticated Streamable HTTP endpoint",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "notion-mcp-bridge": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "token": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64url'))\"",
    "tunnel:cloudflare": "cloudflared tunnel --url http://127.0.0.1:8787",
    "tunnel:ngrok": "ngrok http 8787"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
